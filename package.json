{
  "name": "pickleball-rotation-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "serve:test": "vue-cli-service serve --host 127.0.0.1 --port 4173",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser electron",
    "test:e2e": "start-server-and-test serve:test http-get://127.0.0.1:4173 cypress:run",
    "test:e2e:open": "start-server-and-test serve:test http-get://127.0.0.1:4173 cypress:open",
    "prebuild": "npm run lint && npm run test:e2e",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "core-js": "^3.8.3",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "vue-router": "^4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "cypress": "^15.20.1",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "start-server-and-test": "^3.0.12",
    "typescript": "~5.9.0"
  }
}
