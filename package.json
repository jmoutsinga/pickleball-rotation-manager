{
  "name": "pickleball-rotation-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "serve:test": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "preview": "vite preview",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser electron",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "start-server-and-test serve:test http-get://127.0.0.1:4173 cypress:run",
    "test:e2e:open": "start-server-and-test serve:test http-get://127.0.0.1:4173 cypress:open",
    "prebuild": "npm run type-check && npm run lint && npm run test:unit && npm run test:e2e",
    "build": "vite build",
    "lint": "eslint --ext .js,.ts,.vue src vite.config.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "vue-router": "^4.0.3"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.11",
    "cypress": "^15.20.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.11.2",
    "start-server-and-test": "^3.0.12",
    "typescript": "~5.9.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.123.0"
  }
}
